# Copy to .env and fill in. .env is gitignored and never committed.

# SEC EDGAR requires a real User-Agent on every request, e.g. "Your Name your@email".
# Requests without it are blocked. Required by seed.py to resolve CIKs.
SEC_USER_AGENT=

# Optional. The app runs without these and degrades to rules-only / no-data output.
# Groq has a free tier: https://console.groq.com (keys start gsk_)
GROQ_API_KEY=
# Google Gemini free tier: https://aistudio.google.com/apikey (regional). Newer
# accounts get an AQ.-prefix key (not the classic AIza), which works here; and their
# default gemini-2.0-flash may return 404/quota-zero, so pin a current model:
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# LLM_PROVIDER=groq|gemini|anthropic  (unset auto-selects the first key present)

ANTHROPIC_API_KEY=
FMP_API_KEY=
OPENFDA_API_KEY=
