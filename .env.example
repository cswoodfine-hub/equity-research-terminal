# Copy to .env and fill in. .env is gitignored and never committed.

# SEC EDGAR requires a real User-Agent on every request, e.g. "Your Name your@email".
# Requests without it are blocked. Required by seed.py to resolve CIKs.
SEC_USER_AGENT=

# Optional. The app runs without these and degrades to rules-only / no-data output.
# Google Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# LLM_PROVIDER=gemini|anthropic  (unset auto-selects Gemini first)

ANTHROPIC_API_KEY=
FMP_API_KEY=
OPENFDA_API_KEY=
