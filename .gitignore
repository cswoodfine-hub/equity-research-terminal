# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets
.env

# Claude Code local settings
.claude/settings.local.json

# Local database (WAL mode adds the -shm/-wal sidecars). The compressed copy under
# data/ is deliberately tracked: it is what the deployed app reads, and shipping it
# in the repo is what lets the app work with no token and no network.
*.db
*.db-shm
*.db-wal
*.db.backup-*
# A database opened at a path with no extension matched none of the above, so three
# empty ones named after tickers sat in the repo from August to October. db.get_connection
# now refuses to create, and these catch the sidecars of anything that slips past.
*-shm
*-wal

# Source archive / scratch
files.zip
_extracted/

# OS
.DS_Store
backend/cache/

# Generated tearsheets
exports/*.html

# Scheduled-refresh logs and lock
logs/

# Orphaned inodes left by a file deleted while still open, on this FUSE-backed volume.
# Not artefacts of the project and never wanted in a commit.
.fuse_hidden*
